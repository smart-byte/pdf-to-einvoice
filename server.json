{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.smart-byte/pdf-to-einvoice",
  "title": "pdf-to-einvoice",
  "description": "Turn an invoice PDF into an EN 16931 e-invoice (ZUGFeRD / Factur-X). Runs locally, no upload.",
  "repository": {
    "url": "https://github.com/smart-byte/pdf-to-einvoice",
    "source": "github"
  },
  "websiteUrl": "https://smart-byte.github.io/pdf-to-einvoice/",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "pdf-to-einvoice",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
