{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.smart-byte/pdf-to-einvoice",
  "title": "pdf-to-einvoice",
  "description": "Invoice PDF to EN 16931 e-invoice (ZUGFeRD / Factur-X), or invoice data to XRechnung. Runs locally.",
  "repository": {
    "url": "https://github.com/smart-byte/pdf-to-einvoice",
    "source": "github"
  },
  "websiteUrl": "https://pdf-to-einvoice.app/",
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "pdf-to-einvoice",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
